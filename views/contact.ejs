<%- include('partials/header') %>

<main class="main-content">
    <div style="background: #1a1a1a; padding: 40px; border-radius: 15px; border: 1px solid #d4af37; width: 90%; max-width: 600px;">
        <h2 class="gold-text">Contact <span style="color: white;">Advanced Events</span></h2>
        <p style="color: #888; margin-bottom: 25px;">Submit an enquiry regarding our corporate or private event services.</p>

        <form action="/contact" method="POST" style="display: flex; flex-direction: column; gap: 15px; text-align: left;">
            <div>
                <label style="color: #d4af37; font-size: 0.8rem;">FULL NAME</label>
                <input type="text" name="name" required style="width: 100%; padding: 12px; background: #0a0a0a; border: 1px solid #333; color: white; border-radius: 5px;">
            </div>
            <div>
                <label style="color: #d4af37; font-size: 0.8rem;">EMAIL ADDRESS</label>
                <input type="email" name="email" required style="width: 100%; padding: 12px; background: #0a0a0a; border: 1px solid #333; color: white; border-radius: 5px;">
            </div>
            <div>
                <label style="color: #d4af37; font-size: 0.8rem;">MESSAGE</label>
                <textarea name="message" rows="4" required style="width: 100%; padding: 12px; background: #0a0a0a; border: 1px solid #333; color: white; border-radius: 5px;"></textarea>
            </div>
            <button class="btn-gold" type="submit">Submit Enquiry</button>
        </form>
    </div>
</main>

<%- include('partials/footer') %>