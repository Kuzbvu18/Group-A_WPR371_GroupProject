<%- include('partials/header') %>
<main class="main-content">
    <div style="width: 90%; max-width: 1100px; margin-bottom: 50px;">
        <h2 class="gold-text" style="text-align: left; margin-bottom: 20px;">Platform <span style="color: white;">Analytics</span></h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
            <div style="background: #1a1a1a; padding: 20px; border-radius: 10px; border-left: 5px solid #d4af37;">
                <p style="color: #888; font-size: 0.8rem;">TOTAL BOOKINGS</p>
                <h3 style="font-size: 2rem;">1,284</h3>
            </div>
            <div style="background: #1a1a1a; padding: 20px; border-radius: 10px; border-left: 5px solid #d4af37;">
                <p style="color: #888; font-size: 0.8rem;">POPULAR EVENT</p>
                <h3 style="font-size: 1.2rem;">Summer Ball</h3>
            </div>
            <div style="background: #1a1a1a; padding: 20px; border-radius: 10px; border-left: 5px solid #d4af37;">
                <p style="color: #888; font-size: 0.8rem;">CAPACITY USAGE</p>
                <h3 style="font-size: 2rem;">82%</h3>
            </div>
        </div>
    </div>

    <div style="width: 90%; max-width: 1100px;">
        <h2 class="gold-text" style="text-align: left; margin-bottom: 20px;">My <span style="color: white;">Bookings</span></h2>
        <table style="width: 100%; border-collapse: collapse; background: #1a1a1a;">
            <thead style="border-bottom: 2px solid #d4af37;">
                <tr style="text-align: left; color: #d4af37;">
                    <th style="padding: 15px;">Event</th>
                    <th style="padding: 15px;">Date</th>
                    <th style="padding: 15px;">Status</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom: 1px solid #333;">
                    <td style="padding: 15px;">Private Yacht Mixer</td>
                    <td style="padding: 15px;">20 June 2026</td>
                    <td style="padding: 15px;"><span style="color: #4CAF50;">Confirmed</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</main>
<%- include('partials/footer') %>