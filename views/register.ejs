<%- include('partials/header') %>

<main class="main-content">
    <div style="background: #1a1a1a; padding: 40px; border-radius: 15px; border: 1px solid #333; width: 100%; max-width: 450px;">
        <h2 class="gold-text" style="margin-bottom: 10px;">Member Registration</h2>
        <p style="font-size: 0.9rem; color: #888; margin-bottom: 25px;">Join the elite community of Advanced Events.</p>
        
        <form action="/register" method="POST" style="display: flex; flex-direction: column; gap: 15px; text-align: left;">
            <div style="display: flex; gap: 10px;">
                <div style="flex: 1;">
                    <label style="display: block; margin-bottom: 5px; font-size: 0.8rem; color: #d4af37;">FIRST NAME</label>
                    <input type="text" name="firstName" style="width: 100%; padding: 12px; background: #0a0a0a; border: 1px solid #333; color: white; border-radius: 5px;">
                </div>
                <div style="flex: 1;">
                    <label style="display: block; margin-bottom: 5px; font-size: 0.8rem; color: #d4af37;">LAST NAME</label>
                    <input type="text" name="lastName" style="width: 100%; padding: 12px; background: #0a0a0a; border: 1px solid #333; color: white; border-radius: 5px;">
                </div>
            </div>
            <div>
                <label style="display: block; margin-bottom: 5px; font-size: 0.8rem; color: #d4af37;">EMAIL ADDRESS</label>
                <input type="email" name="email" style="width: 100%; padding: 12px; background: #0a0a0a; border: 1px solid #333; color: white; border-radius: 5px;">
            </div>
            <div>
                <label style="display: block; margin-bottom: 5px; font-size: 0.8rem; color: #d4af37;">CHOOSE PASSWORD</label>
                <input type="password" name="password" style="width: 100%; padding: 12px; background: #0a0a0a; border: 1px solid #333; color: white; border-radius: 5px;">
            </div>
            <button class="btn-gold" type="submit" style="margin-top: 10px;">Create Account</button>
        </form>
        
        <p style="margin-top: 20px; font-size: 0.8rem;">Already a member? <a href="/login" style="color: #d4af37; text-decoration: none;">Login here</a></p>
    </div>
</main>

<%- include('partials/footer') %>